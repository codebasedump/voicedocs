# ── VoiceDocs environment ──────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# .env.local is git-ignored and never committed.

# MongoDB Atlas connection string (required for the backend / API).
# Create a free cluster at https://www.mongodb.com/atlas → "Connect" → "Drivers".
# Choose the Sydney (ap-southeast-2) region for Australian data residency.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# ── AI services (used in a later step when we wire real transcription/formatting)
# Anthropic Claude — document formatting
ANTHROPIC_API_KEY=""
# OpenAI Whisper — voice transcription
OPENAI_API_KEY=""

# ── Auth (added in the auth step)
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
